# Copy to .env at the inner repository root and fill the token locally.
# The launcher loads this file; existing terminal variables take precedence.
ALPHAFORGE_MODE=local
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
# AWS_BEARER_TOKEN_BEDROCK='your-token'

# Optional local settings:
# PORT=4173
# BACKEND_PORT=8000
# PYTHON_EXECUTABLE=C:/path/to/venv/Scripts/python.exe
# AUDIT_DIR=.local-runs
