{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvestorProfile",
  "description": "Validated investor profile used by all agents. Simulation only, not investment advice.",
  "type": "object",
  "required": ["profile_id", "base_currency", "risk_tolerance", "investment_horizon_years"],
  "additionalProperties": false,
  "properties": {
    "profile_id": { "type": "string", "description": "Opaque identifier. Do not use personal data." },
    "base_currency": { "type": "string", "enum": ["CAD", "USD"] },
    "age_range": { "type": "string", "enum": ["18-29", "30-44", "45-59", "60-74", "75+"] },
    "risk_tolerance": { "type": "string", "enum": ["conservative", "moderate", "growth", "aggressive"] },
    "max_drawdown_tolerance_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "investment_horizon_years": { "type": "integer", "minimum": 1, "maximum": 50 },
    "goals": {
      "type": "array",
      "items": { "type": "string", "enum": ["capital_preservation", "income", "growth", "retirement", "major_purchase"] },
      "uniqueItems": true
    },
    "initial_amount": { "type": "number", "minimum": 0 },
    "monthly_contribution": { "type": "number", "minimum": 0 },
    "allowed_asset_classes": {
      "type": "array",
      "items": { "type": "string", "enum": ["equity", "etf_equity", "etf_bond", "etf_commodity", "crypto"] },
      "uniqueItems": true
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sectors": { "type": "array", "items": { "type": "string" } },
        "tickers": { "type": "array", "items": { "type": "string" } },
        "esg_screening_required": { "type": "boolean" }
      }
    },
    "max_single_asset_weight_pct": { "type": "number", "minimum": 1, "maximum": 100 },
    "max_crypto_weight_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "notes": { "type": "string", "maxLength": 1000, "description": "Free text from the investor, interpreted by the Profile Agent." }
  }
}
